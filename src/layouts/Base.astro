---
import "../styles/global.css";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
// The measurement ID is not a secret — it ships in the page source of every
// visit. It is read only in a production build so that `astro dev` page loads
// stay out of the numbers, and so a local build requests nothing at all.
const gaId = import.meta.env.PROD ? import.meta.env.PUBLIC_GA_MEASUREMENT_ID : undefined;
const nav = [
  { href: `${base}decky/`, label: "Decky" },
  { href: `${base}download/`, label: "Download" },
  { href: `${base}changelog/`, label: "Changelog" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0d14" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="masthead">
      <div class="page masthead__inner">
        <a class="wordmark" href={base}>
          <Mark size={26} />
          <span>Playfield</span>
        </a>
        <nav>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={here.startsWith(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <hr class="rule" />
      <div class="page footer__inner">
        <p class="footer__note">
          Playfield is an independent project. It is not affiliated with Valve, Epic Games,
          GOG, Amazon, Electronic Arts, Blizzard, Ubisoft or Microsoft.
        </p>
        <p class="footer__links">
          <a href={`${base}download/`}>Download</a>
          <a href={`${base}changelog/`}>Changelog</a>
          <a href={`${base}decky/`}>Decky plugin</a>
          <a href="https://github.com/sandrocaseiro-dev/playfield-site/releases">Releases</a>
        </p>
      </div>
    </footer>
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            // `define:vars` wraps this in an IIFE, so gtag is hung on window
            // deliberately — that is the name the rest of the site calls to
            // send an event.
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() {
              window.dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </body>
</html>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    height: 58px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: var(--track-tight);
  }

  .masthead nav {
    display: flex;
    gap: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .masthead nav a {
    white-space: nowrap;
    text-decoration: none;
    color: var(--muted);
    padding-block: var(--s-2);
    border-bottom: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .masthead nav a:hover {
    color: var(--bone);
  }

  .masthead nav a[aria-current="page"] {
    color: var(--brass);
    border-bottom-color: var(--brass);
  }

  /* Three links and the wordmark have to share a phone's width. */
  @media (max-width: 26rem) {
    .masthead nav {
      gap: var(--s-4);
      font-size: var(--text-micro);
      letter-spacing: 0;
    }
  }

  .footer {
    margin-top: var(--s-32);
  }

  .footer__inner {
    padding-block: var(--s-8) var(--s-12);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    justify-content: space-between;
    align-items: start;
  }

  .footer__note {
    font-size: var(--text-sm);
    color: var(--faint);
    max-width: 38rem;
  }

  .footer__links {
    display: flex;
    gap: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .footer__links a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--brass);
  }
</style>
