---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getLatestDecky, formatDate } from "../lib/releases";

import shotPage from "../assets/shots/decky/page.png";
import shotSheet from "../assets/shots/decky/sheet.png";
import shotLibrary from "../assets/shots/decky/library.png";
import shotPanel from "../assets/shots/decky/panel.png";
import shotStores from "../assets/shots/decky/stores.png";
import shotDownloads from "../assets/shots/decky/downloads.png";
import shotInstall from "../assets/shots/decky/install.png";
import shotCheats from "../assets/shots/decky/cheats.png";
import shotProton from "../assets/shots/decky/proton.png";
import shotArtwork from "../assets/shots/decky/artwork.png";
import shotHltb from "../assets/shots/decky/hltb.png";
import shotSaves from "../assets/shots/decky/panel-more.png";
import shotTabs from "../assets/shots/decky/tabs.png";
import shotMicrosoft from "../assets/shots/decky/microsoft.png";

const base = import.meta.env.BASE_URL;
const latest = await getLatestDecky();
// The plugin is downloaded from the downloads page, beside Playfield, so this
// page only points there.
const download = `${base}download/#decky`;
// The changelog anchors a plugin release under its prefix, so this lands on the
// plugin's entry rather than on the Playfield release that shares its number.
const changelog = `${base}changelog/${latest ? `#decky-${latest.version}` : ""}`;

// Every shot is Steam's Game Mode at the Deck's own 1280 × 800, so they are
// sized for the width they were taken at rather than stretched past it.
const widths = [640, 960, 1280];

// The panes of the tabbed section, each a screen of Game Mode.
const rest = [
  {
    id: "cheats",
    tab: "Cheats",
    heading: "Cheats and trainers.",
    body: "Build a game's cheats from its Playfield… page, for Steam games and store games in standalone mode, and turn them on from Quick Access while it runs, laid out as the trainer draws them. Trainers can be found, downloaded and deleted there too.",
    shot: shotCheats,
    alt: "DAVE THE DIVER's Playfield… page in Game Mode, on Cheats: 33 built-in cheats, Build them again, Delete and Get a trainer",
  },
  {
    id: "saves",
    tab: "Saves",
    heading: "Cloud saves in Game Mode.",
    body: "A game's save is brought down before you play and sent after, whichever button started it. If two computers both changed it, Steam asks which to keep. The game's page shows whose cloud syncs its save and whether it is synced. Each kept save can be moved on its own, and Quick Access shows what is waiting to be sent.",
    shot: shotSaves,
    alt: "The Playfield panel in Quick Access: Sync now, two waiting updates, seven of eight stores on, saves going to Google Drive with everything sent, library tabs and HowLongToBeat",
  },
  {
    id: "proton",
    tab: "Proton",
    heading: "Proton and launch settings.",
    body: "On a game's Playfield… page, choose the Proton version a Steam game runs under, or a store game's in a prefix of its own when its store runs standalone, and change its launch settings: HDR, the MangoHud overlay and your own. Each store's Proton version is chosen on its page in Quick Access.",
    shot: shotProton,
    alt: "Runs under for Moonlighter, from its Playfield… page: a list of Proton versions, shared with GOG or in its own prefix",
  },
  {
    id: "artwork",
    tab: "Artwork",
    heading: "Change any game's artwork.",
    body: "With a free SteamGridDB key, choose a game's cover, icon, hero, logo and header, Steam's own games included. Your pick shows in Playfield on the desktop too.",
    shot: shotArtwork,
    alt: "Moonlighter's artwork in Game Mode: its cover, icon, hero, logo and header, with store art and SteamGridDB images to choose from",
  },
  {
    id: "hltb",
    tab: "HowLongToBeat",
    heading: "HowLongToBeat in Game Mode.",
    body: "Mark a game backlog, playing, completed or retired from its menu, and link it to HowLongToBeat on its Playfield… page. Sign in from Steam's browser to send your play, Steam games' too.",
    shot: shotHltb,
    alt: "Moonlighter's game menu in Game Mode: Where you are open on Backlog, Playing, Completed and Retired, with Saves, Change artwork and Playfield… below",
  },
  {
    id: "microsoft",
    tab: "Microsoft Store",
    heading: "Microsoft Store games.",
    body: "Install, play and update Microsoft Store games through ferestre, and sign in to Microsoft from Game Mode.",
    shot: shotMicrosoft,
    alt: "Wolfenstein: The Old Blood's page in Game Mode, with Play on Microsoft",
  },
];
---

<Base
  title="Playfield's Decky plugin for Steam's Game Mode"
  description="A Decky plugin for Playfield: install and play your GOG, Epic, Amazon, EA, Battle.net, Ubisoft and Microsoft Store games in Game Mode on a Steam Deck or Linux PC."
>
  <section class="hero">
    <div class="page hero__inner">
      <div class="hero__lockup">
        <p class="eyebrow">Decky plugin for Playfield</p>
        <h1 class="hero__title">
          GOG, Epic and more,<br />
          <span class="hero__title-brass">in Game Mode.</span>
        </h1>
        <p class="lede hero__lede">
          Install and play your GOG, Epic, Amazon, EA, Battle.net, Ubisoft and Microsoft Store
          games, and games you added to Playfield yourself, without leaving Steam.
        </p>

        <div class="dl">
          {
            latest ? (
              <a class="btn btn-primary" href={download}>
                Download the plugin
              </a>
            ) : (
              <span class="btn btn-quiet dl__none">No release yet</span>
            )
          }
        </div>
        {
          latest && (
            <p class="dl__meta">
              Plugin {latest.version} · released {formatDate(latest.date)}
            </p>
          )
        }
      </div>

      <figure class="shot shot--hero">
        <Image src={shotPage} alt="Enter the Gungeon's page in Game Mode: not on this disk, 308 MB, 51 minutes played and Proton - Experimental above Install on Amazon, and the Playfield tab's Where you are, Saves and Cheats" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Library</p>
        <h2>Each store's games, with artwork and their own collection.</h2>
        <p class="lede">
          Games from the stores you turn on appear in Steam's library with their artwork. Each tile shows which stores you own the game on, and games that aren't installed are dimmed and read <em>Not installed</em> on Home. Each store gets its own collection, plus one for all your games and one for everything installed.
        </p>
        <p class="lede">
          Your Playfield collections show in Steam too. Add a game to one in Steam or take one out, and the collection changes in Playfield. Collections made from a search stay as Playfield fills them.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotLibrary} alt="Playfield · Fast Finish, one of your Playfield collections, in Steam's library: games from Amazon, Steam, Epic and GOG, each with its store's icon" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Library tabs</p>
        <h2>Arrange Steam's library tabs.</h2>
        <p class="lede">
          Reorder and hide Steam's library tabs, and add any collection as a tab, such as a store's. Nothing of Steam's is deleted, and <em>Back to Steam's order</em> undoes it all.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotTabs} alt="Library tabs in Quick Access: Steam's own tabs in order, Add a collection and Back to Steam's order" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">On the game's page</p>
        <h2>Install, play and uninstall from Steam's page.</h2>
        <p class="lede">
          Before you install a game, its page shows its size and the Proton version it will run under. Install opens the store's app in Game Mode to install the game. If you own it on more than one store, choose which one, and for a GOG game its language and DLC. Once it is installed, Steam's <em>Play</em> button starts it.
        </p>
        <p class="lede">
          <em>Uninstall</em> in the game's <em>Manage</em> menu removes the game and keeps its Steam entry, playtime and controller layout.
        </p>
        <p class="lede">
          Experimental: games from a store in Playfield's standalone mode download without opening the store's app, with Pause, Resume and Cancel. <em>Update</em> appears next to <em>Play</em> when a new version is out, and <em>Check the files</em> is in the <em>Manage</em> menu.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotInstall} alt="The Abandoned Planet's page in Game Mode, not installed: 555 MB, Proton - Experimental and an Install on Amazon button" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Playfield tab</p>
        <h2>A Playfield tab on every game's page.</h2>
        <p class="lede">
          Every game's page, Steam games too, shows Playfield's facts beside <em>Play</em>: playtime, size, ProtonDB rating, and a cloud for whoever syncs its saves. Its <em>Playfield</em> tab shows where you are, your saves and your cheats above its trailers and screenshots.
        </p>
        <p class="lede">
          <em>Playfield…</em> in the game's menu opens a page for the game's settings: how it runs, saves, cheats, HowLongToBeat and achievements.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotSheet} alt="DAVE THE DIVER's page in Game Mode: its size, playtime, Proton and Steam Cloud beside Update, and the Playfield tab's Where you are, Saves and Cheats above its trailers" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Downloads and updates</p>
        <h2>Updates in Steam's Downloads.</h2>
        <p class="lede">
          Playfield's downloads and updates show in Steam's Downloads screen, on the game's tile and on Home. Updates have patch notes where the store publishes them, and can start one at a time or all at once.
        </p>
        <p class="lede">
          Choose how each game updates, and whether downloads keep going while it runs. An install that runs out of space can move to another drive.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotDownloads} alt="Steam's Downloads screen in Game Mode, with Diablo IV and Down in Bermuda under Not scheduled and an Update all button" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Quick Access</p>
        <h2>Choose which stores show up.</h2>
        <p class="lede">
          Quick Access has a page for your stores. Turn each one on or off, see how many of its games are in Steam, how it installs and the Proton version it runs under. Turning a store off leaves its games and playtime in Steam until you remove them.
        </p>
        <p class="lede">
          Quick Access also lists waiting downloads and updates. While a sync runs, its progress shows in Steam's top bar.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotPanel} alt="The Stores page in Quick Access: each store on or off, with how many of its games are in Steam and whether it runs standalone" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Stores</p>
        <h2>Open your store apps from Game Mode.</h2>
        <p class="lede">
          Each store's app gets a tile in Steam, so you can sign in again without going to the desktop.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotStores} alt="The Playfield · Stores collection: tiles for Amazon Games, Battle.net, EA, the Epic Games Store, the Microsoft Store, GOG Galaxy and Ubisoft Connect" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="rest">
    <div class="page">
      <h2 class="rest__heading">What else the plugin does.</h2>

      <div class="tabs" data-tabs>
        <div class="tabs__bar" role="tablist" aria-label="What else the plugin does">
          {
            rest.map((pane, i) => (
              <button
                class="tabs__tab"
                role="tab"
                type="button"
                id={`tab-${pane.id}`}
                aria-controls={`pane-${pane.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                {pane.tab}
              </button>
            ))
          }
        </div>

        {
          rest.map((pane) => (
            <div
              class="tabs__pane"
              role="tabpanel"
              id={`pane-${pane.id}`}
              aria-labelledby={`tab-${pane.id}`}
              tabindex="0"
            >
              <div class="tabs__text">
                <h3>{pane.heading}</h3>
                <p>{pane.body}</p>
              </div>
              <figure class="shot">
                <Image src={pane.shot} alt={pane.alt} widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" loading="lazy" />
              </figure>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="page statement">
      <div>
        <h2>What it needs</h2>
      </div>
      <div class="statement__body">
        <ol class="needs">
          <li>
            <strong>Playfield for Linux</strong> on the same computer, with your stores set up.{" "}
            <a href={`${base}download/`}>Download Playfield</a>
          </li>
          <li>
            <strong>Decky Loader</strong>, which adds plugins to Steam's Game Mode.
          </li>
          <li>
            <strong>This plugin.</strong> It isn't in Decky's store: in Decky's settings, turn on
            Developer mode, then install the zip from the Developer section.
            {latest && <> <a href={download}>Download the plugin</a></>}
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="page closing__inner">
      <h2 class="closing__heading">Get the Decky plugin.</h2>
      <div class="dl">
        {
          latest ? (
            <a class="btn btn-primary" href={download}>
              Download the plugin
            </a>
          ) : (
            <a class="btn btn-primary" href={`${base}download/`}>Download Playfield</a>
          )
        }
        <a class="btn btn-quiet" href={changelog}>Read the changelog</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // The panes are all in the document and all visible until this runs, so the
  // section reads as stacked sections without JavaScript and collapses to
  // one at a time with it.
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panes = tabs.map((tab) =>
      document.getElementById(tab.getAttribute("aria-controls")!),
    );

    const show = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        panes[i]?.toggleAttribute("hidden", !on);
      });
      if (focus) tabs[index]!.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => show(i, false));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1, Home: -i, End: tabs.length - 1 - i }[
          event.key
        ];
        if (step === undefined) return;
        event.preventDefault();
        show((i + step + tabs.length) % tabs.length, true);
      });
    });

    root.dataset.live = "true";
    show(0, false);
  }
</script>

<style>
  /* Hero ---------------------------------------------------------------- */

  .hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
    background:
      radial-gradient(60rem 32rem at 12% -10%, rgb(224 164 88 / 0.09), transparent 70%),
      var(--ink);
  }

  .hero__lockup {
    max-width: 52rem;
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.94;
    margin-top: var(--s-4);
  }

  .hero__title-brass {
    color: var(--brass);
  }

  .hero__lede {
    margin-top: var(--s-6);
  }

  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  .dl__none {
    cursor: default;
  }

  .dl__meta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--faint);
    margin-top: var(--s-4);
  }

  /* Screenshots ---------------------------------------------------------- */

  .shot {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--slate);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.55);
    max-width: 68rem;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .shot--hero {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .feature--flip .shot {
    margin-left: auto;
  }

  /* Bands and features --------------------------------------------------- */

  .band {
    padding-block: var(--s-24);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  .statement {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .statement h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .statement__body .lede + .lede {
    margin-top: var(--s-6);
  }

  .needs {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--s-4);
    color: var(--muted);
  }

  .needs li::marker {
    color: var(--brass);
    font-family: var(--font-mono);
  }

  .needs strong {
    color: var(--bone);
    font-weight: 600;
  }

  .needs a {
    color: var(--brass);
  }

  .feature {
    padding-block: var(--s-24) 0;
  }

  .feature__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .feature__text {
    max-width: 44rem;
  }

  .feature--flip .feature__text {
    margin-left: auto;
  }

  .feature__text h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .feature__text .lede {
    margin-top: var(--s-6);
  }

  /* The tabbed section --------------------------------------------------- */

  .rest {
    padding-block: var(--s-24);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  .rest__heading {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
    max-width: 30rem;
  }

  /* A segmented control rather than a row of underlined words — the shape the
     application itself uses wherever one of a few states is current. */
  .tabs__bar {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-12);
    padding: var(--s-1);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--slate);
  }

  .tabs__tab {
    appearance: none;
    background: none;
    border: 0;
    border-radius: var(--radius);
    padding: var(--s-3) var(--s-6);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.2;
    color: var(--faint);
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }

  .tabs__tab:hover {
    background: var(--slate-hi);
    color: var(--bone);
  }

  .tabs__tab:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .tabs__tab[aria-selected="true"],
  .tabs__tab[aria-selected="true"]:hover {
    background: var(--brass);
    color: var(--on-accent);
    font-weight: 600;
  }

  .tabs__pane {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: var(--s-12);
  }

  /* Without the script every pane stays in the flow, so each one needs the rule
     the tab bar would otherwise draw between them. */
  .tabs:not([data-live]) .tabs__pane + .tabs__pane {
    border-top: 1px solid var(--hairline);
  }

  .tabs__pane[hidden] {
    display: none;
  }

  .tabs__pane:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: var(--s-4);
  }

  .tabs__text {
    max-width: 44rem;
  }

  .tabs__text h3 {
    font-size: var(--text-xl);
  }

  .tabs__text p {
    margin-top: var(--s-4);
    color: var(--muted);
  }

  /* Closing -------------------------------------------------------------- */

  .closing {
    padding-block: var(--s-16) var(--s-8);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  .closing__heading {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  /* Narrow --------------------------------------------------------------- */

  @media (max-width: 60rem) {
    .statement {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature--flip .feature__text,
    .feature--flip .shot {
      margin-left: 0;
    }
  }
</style>
