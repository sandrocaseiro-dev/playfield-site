---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getLatestDecky, formatDate } from "../lib/releases";

import shotPage from "../assets/shots/decky/page.png";
import shotSheet from "../assets/shots/decky/sheet.png";
import shotLibrary from "../assets/shots/decky/library.png";
import shotPanel from "../assets/shots/decky/panel.png";
import shotStores from "../assets/shots/decky/stores.png";

const base = import.meta.env.BASE_URL;
const latest = await getLatestDecky();
// The plugin is downloaded from the downloads page, beside Playfield, so this
// page only points there.
const download = `${base}download/#decky`;
// The changelog anchors a plugin release under its prefix, so this lands on the
// plugin's entry rather than on the Playfield release that shares its number.
const changelog = `${base}changelog/${latest ? `#decky-${latest.version}` : ""}`;

// Every shot is Steam's Game Mode at the Deck's own 1280 × 800, so they are
// sized for the width they were taken at rather than stretched past it.
const widths = [640, 960, 1280];
---

<Base
  title="Playfield's Decky plugin for Steam's Game Mode"
  description="Install and play your GOG, Epic, Amazon, EA, Battle.net and Ubisoft games in Steam's Game Mode, on a Steam Deck or any Linux computer. A Decky plugin for Playfield."
>
  <section class="hero">
    <div class="page hero__inner">
      <div class="hero__lockup">
        <p class="eyebrow">Decky plugin for Playfield</p>
        <h1 class="hero__title">
          GOG, Epic and more,<br />
          <span class="hero__title-brass">in Game Mode.</span>
        </h1>
        <p class="lede hero__lede">
          Install and play your GOG, Epic, Amazon, EA, Battle.net and Ubisoft games, and games
          you added to Playfield yourself, without leaving Steam.
        </p>

        <div class="dl">
          {
            latest ? (
              <a class="btn btn-primary" href={download}>
                Download the plugin
              </a>
            ) : (
              <span class="btn btn-quiet dl__none">No release yet</span>
            )
          }
        </div>
        {
          latest && (
            <p class="dl__meta">
              Plugin {latest.version} · released {formatDate(latest.date)}
            </p>
          )
        }
      </div>

      <figure class="shot shot--hero">
        <Image src={shotPage} alt="Enter the Gungeon's page in Game Mode, with an Install on Amazon button and a Playfield tab" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="page statement">
      <div>
        <p class="eyebrow">Setup</p>
        <h2>Set up your stores in Playfield on the desktop.</h2>
      </div>
      <div class="statement__body">
        <p class="lede">
          The plugin adds their games to Steam. It syncs when Steam starts, after an install,
          and when you press <em>Sync</em> in Quick Access.
        </p>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Library</p>
        <h2>Each store's games, with artwork and their own collection.</h2>
        <p class="lede">
          Games from the stores you turn on appear in Steam's library with their artwork. An icon shows which store each is from, and uninstalled games are dimmed. Each store gets its own collection, plus one for everything installed.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotLibrary} alt="The Playfield · Amazon collection in Steam's library: each game has an Amazon icon, and uninstalled games are dimmed" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">On the game's page</p>
        <h2>A Playfield tab and an Install button on every game's page.</h2>
        <p class="lede">
          Install opens the store's app in Game Mode to install the game. If you own it on more than one store, choose which one. Once it is installed, Steam's <em>Play</em> button starts it.
        </p>
        <p class="lede">
          Experimental: Amazon games can download without opening the Amazon app. Progress shows on the game's page and in Steam's Downloads.
        </p>
        <p class="lede">
          Every game's page, Steam games too, gets a <em>Playfield</em> tab with the description, trailers, screenshots, the stores you own it on, size, release date and critic score.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotSheet} alt="The Playfield tab on a game's page: description, tags, trailers and screenshots, the stores you own it on, release date and critic score" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Quick Access</p>
        <h2>Choose which stores show up.</h2>
        <p class="lede">
          Turn stores on or off in Quick Access and see how many of their games are in Steam. Turning a store off leaves its games and playtime in Steam.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotPanel} alt="The Playfield panel in Quick Access, with a switch and a game count for each store" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Stores</p>
        <h2>Open your store apps from Game Mode.</h2>
        <p class="lede">
          Each store's app gets a tile in Steam, so you can sign in again without going to the desktop.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotStores} alt="The Playfield · Stores collection: tiles for Amazon Games, Battle.net, EA, the Epic Games Store, GOG Galaxy and Ubisoft Connect" widths={widths} sizes="(max-width: 60rem) 100vw, 1100px" />
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="page statement">
      <div>
        <h2>What it needs</h2>
      </div>
      <div class="statement__body">
        <ol class="needs">
          <li>
            <strong>Playfield for Linux</strong> on the same computer, with your stores set up.{" "}
            <a href={`${base}download/`}>Download Playfield</a>
          </li>
          <li>
            <strong>Decky Loader</strong>, which adds plugins to Steam's Game Mode.
          </li>
          <li>
            <strong>This plugin.</strong> It isn't in Decky's store: in Decky's settings, turn on
            Developer mode, then install the zip from the Developer section.
            {latest && <> <a href={download}>Download the plugin</a></>}
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="page closing__inner">
      <h2 class="closing__heading">Get the Decky plugin.</h2>
      <div class="dl">
        {
          latest ? (
            <a class="btn btn-primary" href={download}>
              Download the plugin
            </a>
          ) : (
            <a class="btn btn-primary" href={`${base}download/`}>Download Playfield</a>
          )
        }
        <a class="btn btn-quiet" href={changelog}>Read the changelog</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero ---------------------------------------------------------------- */

  .hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
    background:
      radial-gradient(60rem 32rem at 12% -10%, rgb(224 164 88 / 0.09), transparent 70%),
      var(--ink);
  }

  .hero__lockup {
    max-width: 52rem;
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.94;
    margin-top: var(--s-4);
  }

  .hero__title-brass {
    color: var(--brass);
  }

  .hero__lede {
    margin-top: var(--s-6);
  }

  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  .dl__none {
    cursor: default;
  }

  .dl__meta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--faint);
    margin-top: var(--s-4);
  }

  /* Screenshots ---------------------------------------------------------- */

  .shot {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--slate);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.55);
    max-width: 68rem;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .shot--hero {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .feature--flip .shot {
    margin-left: auto;
  }

  /* Bands and features --------------------------------------------------- */

  .band {
    padding-block: var(--s-24);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  .statement {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .statement h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .statement__body .lede + .lede {
    margin-top: var(--s-6);
  }

  .needs {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--s-4);
    color: var(--muted);
  }

  .needs li::marker {
    color: var(--brass);
    font-family: var(--font-mono);
  }

  .needs strong {
    color: var(--bone);
    font-weight: 600;
  }

  .needs a {
    color: var(--brass);
  }

  .feature {
    padding-block: var(--s-24) 0;
  }

  .feature__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .feature__text {
    max-width: 44rem;
  }

  .feature--flip .feature__text {
    margin-left: auto;
  }

  .feature__text h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .feature__text .lede {
    margin-top: var(--s-6);
  }

  /* Closing -------------------------------------------------------------- */

  .closing {
    padding-block: var(--s-16) var(--s-8);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  .closing__heading {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  /* Narrow --------------------------------------------------------------- */

  @media (max-width: 60rem) {
    .statement {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature--flip .feature__text,
    .feature--flip .shot {
      margin-left: 0;
    }
  }
</style>
