---
import Base from "../layouts/Base.astro";
import EarlierReleases from "../components/EarlierReleases.astro";
import {
  getAppReleases,
  getLatest,
  getDeckyReleases,
  getLatestDecky,
  pickPluginZip,
  pickChecksums,
  formatBytes,
  formatDate,
  type AssetKind,
} from "../lib/releases";

const base = import.meta.env.BASE_URL;
const releases = await getAppReleases();
const latest = await getLatest();
const older = releases.filter((r) => r.tag !== latest?.tag).slice(0, 8);

// The Decky plugin is downloaded here too, beneath Playfield: one page for
// everything there is to download, each under its own name and version.
const decky = await getLatestDecky();
const deckyFiles = [
  { asset: pickPluginZip(decky), what: "Install it from the Developer section of Decky's settings" },
  { asset: pickChecksums(decky), what: "Checksums for the plugin" },
].filter((file) => file.asset !== null);
const deckyOlder = (await getDeckyReleases()).filter((r) => r.tag !== decky?.tag).slice(0, 8);

const describe: Record<AssetKind, string> = {
  installer: "Installer (recommended)",
  msi: "MSI package",
  appimage: "AppImage — runs without installing. Make it executable, then open it. Use this one on a Steam Deck.",
  deb: "Debian package — for Debian, Ubuntu and similar systems",
  checksums: "Checksums for everything above",
  other: "",
};

// One block per platform, and the files that belong to neither underneath them
// both. A release from before Linux existed simply draws one block.
const groups = [
  { platform: "windows" as const, title: "Windows", note: "Windows 10 and 11, 64-bit." },
  {
    platform: "linux" as const,
    title: "Linux",
    note: "64-bit.",
  },
].filter((group) => latest?.assets.some((a) => a.platform === group.platform));

const loose = latest?.assets.filter((a) => a.platform === null) ?? [];
---

<Base
  title="Download Playfield"
  description="Download Playfield for Windows and Linux, and its Decky plugin for Steam's Game Mode."
>
  <section class="head">
    <div class="page">
      <h1>Download</h1>
      {
        latest ? (
          <p class="lede">
            Playfield {latest.version}, released {formatDate(latest.date)}.
            {latest.headline ? ` ${latest.headline}.` : ""}
          </p>
        ) : (
          <p class="lede">
            There is no release yet. When there is, it appears here and on the
            {" "}<a href={`${base}changelog/`}>changelog</a>.
          </p>
        )
      }
      {
        decky && deckyFiles.length > 0 && (
          <p class="head__also">
            <a href="#decky">The Decky plugin is further down.</a>
          </p>
        )
      }
    </div>
  </section>

  {
    latest && (
      <div class="page app">
        {groups.map((group) => (
          <section class="platform">
            <h2>{group.title}</h2>
            <p class="platform__note">{group.note}</p>
            <div class="files">
              {latest.assets
                .filter((asset) => asset.platform === group.platform)
                .map((asset) => (
                  <a class="file" href={asset.url} download>
                    <span class="file__name">{asset.name}</span>
                    <span class="file__what">{describe[asset.kind]}</span>
                    <span class="file__size">{formatBytes(asset.size)}</span>
                  </a>
                ))}
            </div>
          </section>
        ))}

        {loose.length > 0 && (
          <div class="files files--loose">
            {loose.map((asset) => (
              <a class="file" href={asset.url} download>
                <span class="file__name">{asset.name}</span>
                <span class="file__what">{describe[asset.kind]}</span>
                <span class="file__size">{formatBytes(asset.size)}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    )
  }

  {
    decky && deckyFiles.length > 0 && (
      <section class="page decky" id="decky">
        <p class="eyebrow">For Steam's Game Mode</p>
        <h2>Decky plugin</h2>
        <p class="decky__note">
          Plugin {decky.version}, released {formatDate(decky.date)}. It needs Playfield for
          Linux on the same computer, and Decky Loader.{" "}
          <a href={`${base}decky/`}>See what the plugin does.</a>
        </p>
        <div class="files">
          {deckyFiles.map(({ asset, what }) => (
            <a class="file" href={asset!.url} download>
              <span class="file__name">{asset!.name}</span>
              <span class="file__what">{what}</span>
              <span class="file__size">{formatBytes(asset!.size)}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <EarlierReleases
    groups={[
      { product: "Playfield", releases: older },
      { product: "Decky plugin", releases: deckyOlder },
    ]}
  />
</Base>

<style>
  .head {
    padding-block: var(--s-16) var(--s-8);
  }

  .head h1 {
    font-size: var(--text-3xl);
    margin-top: var(--s-3);
  }

  .head .lede {
    margin-top: var(--s-4);
    max-width: 44rem;
  }

  .head__also {
    margin-top: var(--s-3);
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .head__also a {
    color: var(--brass);
  }

  .app {
    padding-bottom: var(--s-16);
  }

  .platform {
    margin-block: var(--s-12) 0;
  }

  .platform h2 {
    font-size: var(--text-xl);
  }

  .platform__note {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .files {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }

  .files--loose {
    margin-top: var(--s-8);
  }

  .decky {
    padding-block: var(--s-12) var(--s-16);
    border-top: 1px solid var(--hairline);
    scroll-margin-top: var(--s-16);
  }

  .decky h2 {
    font-size: var(--text-xl);
    margin-top: var(--s-3);
  }

  .decky__note {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--faint);
    max-width: 44rem;
  }

  .decky__note a {
    color: var(--brass);
  }

  .file {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) var(--s-6);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--slate);
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .file:hover {
    border-color: var(--brass-dim);
    background: var(--slate-hi);
  }

  .file__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--brass);
    overflow-wrap: anywhere;
  }

  .file__what {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .file__size {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 46rem) {
    .file {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .file__what {
      grid-column: 1 / -1;
    }
  }
</style>
