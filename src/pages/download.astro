---
import Base from "../layouts/Base.astro";
import { getReleases, getLatest, formatBytes, formatDate, type AssetKind } from "../lib/releases";

const base = import.meta.env.BASE_URL;
const releases = await getReleases();
const latest = await getLatest();
const older = releases.filter((r) => r.tag !== latest?.tag).slice(0, 8);

const describe: Record<AssetKind, string> = {
  installer: "Installer — the one to take if you are unsure",
  msi: "MSI package — for deploying without the installer's prompts",
  appimage: "AppImage — runs on any distribution, nothing to install",
  deb: "Debian package — for Debian, Ubuntu and anything that takes a .deb",
  checksums: "Checksums for everything above",
  other: "",
};

// One block per platform, and the files that belong to neither underneath them
// both. A release from before Linux existed simply draws one block.
const groups = [
  { platform: "windows" as const, title: "Windows", note: "Windows 10 and 11, 64-bit." },
  {
    platform: "linux" as const,
    title: "Linux",
    note: "64-bit. The AppImage needs no install; mark it executable and open it.",
  },
].filter((group) => latest?.assets.some((a) => a.platform === group.platform));

const loose = latest?.assets.filter((a) => a.platform === null) ?? [];

// The updater names the package it is updating, so the sentence about it only
// names the packages this release actually shipped.
const PACKAGE_NAMES: [AssetKind, string][] = [
  ["installer", "the installer"],
  ["msi", "the MSI"],
  ["appimage", "the AppImage"],
  ["deb", "the .deb"],
];
const packages = PACKAGE_NAMES.filter(([kind]) =>
  latest?.assets.some((a) => a.kind === kind),
).map(([, name]) => name);
const packageList = packages.length
  ? `${packages.slice(0, -1).join(", ")} or ${packages.at(-1)}`
  : "";
---

<Base
  title="Download Playfield"
  description="Playfield for Windows and Linux — installer, MSI package, AppImage, Debian package and checksums."
>
  <section class="head">
    <div class="page">
      <p class="eyebrow">Windows and Linux, 64-bit</p>
      <h1>Download</h1>
      {
        latest ? (
          <p class="lede">
            Version {latest.version}, released {formatDate(latest.date)}.
            {latest.headline ? ` ${latest.headline}.` : ""}
          </p>
        ) : (
          <p class="lede">
            There is no release yet. When there is, it appears here and on the
            {" "}<a href={`${base}changelog/`}>changelog</a>.
          </p>
        )
      }
    </div>
  </section>

  {
    latest && (
      <div class="page">
        {groups.map((group) => (
          <section class="platform">
            <h2>{group.title}</h2>
            <p class="platform__note">{group.note}</p>
            <div class="files">
              {latest.assets
                .filter((asset) => asset.platform === group.platform)
                .map((asset) => (
                  <a class="file" href={asset.url} download>
                    <span class="file__name">{asset.name}</span>
                    <span class="file__what">{describe[asset.kind]}</span>
                    <span class="file__size">{formatBytes(asset.size)}</span>
                  </a>
                ))}
            </div>
          </section>
        ))}

        {loose.length > 0 && (
          <div class="files files--loose">
            {loose.map((asset) => (
              <a class="file" href={asset.url} download>
                <span class="file__name">{asset.name}</span>
                <span class="file__what">{describe[asset.kind]}</span>
                <span class="file__size">{formatBytes(asset.size)}</span>
              </a>
            ))}
          </div>
        )}

        <section class="after">
          <h2>After the first one</h2>
          <p>
            Playfield updates itself in place, whichever of these you took{" "}
            {packageList && `— ${packageList}`}. It tells you when there is a newer version
            and installs it over this one, and never leaves a second Playfield behind.
          </p>
          <p>
            Everything it knows — your library, your settings, the store sign-ins, the
            artwork — lives in a <code>data</code> folder beside the program, so a copy on a
            stick carries the lot with nothing to switch on. Where the operating system will
            not allow writing there, Playfield says so and uses this machine's folders
            instead.
          </p>
        </section>
      </div>
    )
  }

  {
    older.length > 0 && (
      <section class="page older">
        <h2>Earlier releases</h2>
        <ul>
          {older.map((release) => (
            <li>
              <a href={release.url}>
                <span class="older__version">{release.version}</span>
                <span class="older__date">{formatDate(release.date)}</span>
                {release.prerelease && <span class="older__tag">pre-release</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .head {
    padding-block: var(--s-16) var(--s-8);
  }

  .head h1 {
    font-size: var(--text-3xl);
    margin-top: var(--s-3);
  }

  .head .lede {
    margin-top: var(--s-4);
    max-width: 44rem;
  }

  .platform {
    margin-block: var(--s-12) 0;
  }

  .platform h2 {
    font-size: var(--text-xl);
  }

  .platform__note {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .files {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }

  .files--loose {
    margin-top: var(--s-8);
  }

  .after {
    padding-block: var(--s-12) var(--s-16);
    margin-top: var(--s-16);
    border-top: 1px solid var(--hairline);
  }

  .after h2 {
    font-size: var(--text-xl);
  }

  .after p {
    margin-top: var(--s-4);
    max-width: 44rem;
    color: var(--muted);
  }

  .after code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--brass);
  }

  .file {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) var(--s-6);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--slate);
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .file:hover {
    border-color: var(--brass-dim);
    background: var(--slate-hi);
  }

  .file__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--brass);
    overflow-wrap: anywhere;
  }

  .file__what {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .file__size {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    white-space: nowrap;
  }

  .older {
    padding-block: var(--s-8) var(--s-16);
    border-top: 1px solid var(--hairline);
  }

  .older h2 {
    font-size: var(--text-xl);
  }

  .older ul {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
  }

  .older a {
    display: flex;
    gap: var(--s-6);
    align-items: baseline;
    padding-block: var(--s-3);
    border-top: 1px solid var(--hairline);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .older a:hover .older__version {
    color: var(--brass);
  }

  .older__version {
    color: var(--bone);
    min-width: 5rem;
  }

  .older__tag {
    color: var(--warn);
  }

  @media (max-width: 46rem) {
    .file {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .file__what {
      grid-column: 1 / -1;
    }
  }
</style>
