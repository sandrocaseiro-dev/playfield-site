---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import StoreChip from "../components/StoreChip.astro";
import Download from "../components/Download.astro";
import { getLatest, formatDate } from "../lib/releases";

import shotDetails from "../assets/shots/details.png";
import shotLibrary from "../assets/shots/library.png";
import shotCollections from "../assets/shots/collections.png";
import shotCouch from "../assets/shots/couch-home.png";
import shotDeals from "../assets/shots/deals.png";
import shotBeat from "../assets/shots/beat.png";
import shotAchievements from "../assets/shots/achievements.png";
import shotCheats from "../assets/shots/cheats.png";
import shotStream from "../assets/shots/stream.png";
import shotPrefixes from "../assets/shots/prefixes.png";
import shotExternal from "../assets/shots/external.png";

const base = import.meta.env.BASE_URL;
const latest = await getLatest();

const stores = [
  { id: "steam", label: "Steam" },
  { id: "epic", label: "Epic Games" },
  { id: "gog", label: "GOG" },
  { id: "amazon", label: "Amazon Games" },
  { id: "ea", label: "EA" },
  { id: "bnet", label: "Battle.net" },
  { id: "ubi", label: "Ubisoft" },
  { id: "msft", label: "Microsoft Store" },
] as const;

// The panes of the tabbed section. Each one is a screen of the real
// application, so the tab it sits behind is named after what that screen shows
// rather than after the service it reads.
const rest = [
  {
    id: "beat",
    tab: "Playtime and progress",
    heading: "How long it takes, and how far in you are.",
    body: "Main story, extras, and everything — from HowLongToBeat, next to the hours you have actually played. Mark a game backlog, playing, completed or retired, and correct the hours yourself when a store has them wrong. Sign in to HowLongToBeat and your hours go onto your list there too, one game or the whole library.",
    shot: shotBeat,
    alt: "A game's page in Playfield, showing how long it takes to beat beside how long it has been played",
  },
  {
    id: "achievements",
    tab: "Achievements",
    heading: "Every achievement, from every store.",
    body: "Steam, GOG and Epic on the game's own page — and Microsoft on Windows. Played the same game on two of them? You see both records together.",
    shot: shotAchievements,
    alt: "The achievements panel, showing one game's Steam and GOG records side by side",
  },
  {
    id: "cheats",
    tab: "Trainers and cheats",
    heading: "Cheats, without the download hunt.",
    body: "Get a trainer in one press — or, with a Wand account, have Playfield build the cheats itself for the copy of the game on this disk. Either way they go in when the game starts and come out when it closes, pressed from a window beside the game or from a page your phone can open.",
    shot: shotCheats,
    alt: "A game's page with its cheats panel, naming the version and the options it carries",
  },
  {
    id: "external",
    tab: "Games from anywhere",
    heading: "A program on this disk is a game in your library.",
    body: "Point Playfield at the file. It suggests a name, looks the game up and brings back the cover and the description, and the row sits beside everything the stores gave you — played, timed and searched like any other. Nothing is moved, copied or installed, and removing it never touches the files.",
    shot: shotExternal,
    alt: "The Add a game dialog over the collections page, with the External collection behind it",
  },
  {
    id: "deals",
    tab: "Prices worth waiting for",
    heading: "A waitlist that knows what you already own.",
    body: "Connect IsThereAnyDeal, watch the games you want and catch them when they drop. Your currency, your shops, a countdown on offers about to end, and a mark on anything at its lowest price yet.",
    shot: shotDeals,
    alt: "The deals pane, showing waitlisted games at their current prices across several shops",
  },
];
---

<Base
  title="Playfield — all your games, every store, one library"
  description="Your games are scattered across eight stores and eight launchers. Playfield gathers them into one library you actually browse, instead of hunting for what you own. Windows and Linux."
>
  <section class="hero">
    <div class="page hero__inner">
      <div class="hero__lockup">
        <Mark size={96} settle class="hero__mark" />
        <h1 class="hero__title">
          All your games.<br />
          <span class="hero__title-brass">Every store.<br />One place.</span>
        </h1>
        <p class="lede hero__lede">
          Steam, Epic, GOG, Amazon, EA, Battle.net, Ubisoft and the Microsoft Store — every
          game you own, on one shelf. On Windows, and on Linux for all but the Microsoft Store.
        </p>

        <Download />

        <ul class="chiprow" aria-label="Stores Playfield reads">
          {
            stores.map((store) => (
              <li>
                <StoreChip store={store.id} label={store.label} size={30} />
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="shot shot--hero">
        <Image src={shotDetails} alt="A game's page in Playfield, showing which stores it is owned on" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1100px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="band" id="no-sign-in">
    <div class="page statement">
      <div>
        <p class="eyebrow">Nothing to sign in to</p>
        <h2>Open it. It finds your games.</h2>
      </div>
      <div class="statement__body">
        <p class="lede">
          No stores to connect. Playfield reads the store apps you are already signed in to on
          this machine and fills your shelf from them.
        </p>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">One row per game, not per purchase</p>
        <h2>Bought twice, listed once.</h2>
        <p class="lede">
          The same game from three stores is one entry, not three. Press Play and it starts
          the copy you actually have installed.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotLibrary} alt="The Playfield library, with shelves for what is playing now and what to jump back into" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">A collection is a question, not a folder</p>
        <h2>Describe the shelf. It fills itself.</h2>
        <p class="lede">
          <code>beat&lt;15</code> is every game you could finish this month.
          {" "}<code>store:gog -played:</code> is what you bought on GOG and never once
          started. Write the query one time; the shelf stays right as the library changes
          underneath it.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotCollections} alt="Collections in Playfield, each one a saved query over the library" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Windows and Linux</p>
        <h2>On Linux, with the Windows stores still in it.</h2>
        <p class="lede">
          Steam comes straight from the app you already have. GOG Galaxy, the Epic launcher,
          Amazon Games, Ubisoft Connect, the EA app and Battle.net work on Linux too:
          Playfield installs each one for you, on the Proton version you choose. Already run
          one under Lutris, Heroic or Bottles? Point Playfield at it instead of installing it
          again.
        </p>
        <p class="lede">
          A game's page shows its ProtonDB rating and the Proton version it runs under, and a
          game with a Linux version of its own is marked native. The Microsoft Store is the
          one store Linux doesn't get.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotPrefixes} alt="Playfield's store settings on Linux, with a prefix under the GOG row and the Proton builds on this machine" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">From the sofa</p>
        <h2>Made for a controller and a television.</h2>
        <p class="lede">
          The same library, sized for the far side of the room and driven entirely from a
          pad. Switch to it from the title bar, and Playfield opens in it next time.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotCouch} alt="Playfield's console shell — a wall of covers with the stores as tabs across the top" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Streaming · Windows</p>
        <h2>Your shelf, on the client in the other room.</h2>
        <p class="lede">
          Pick a collection and those games appear on your Vibepollo host on Windows, ready
          to start from any Moonlight client. The couch shell goes over with them, so the
          television gets the whole library.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotStream} alt="Playfield's Vibepollo tab, with the host address filled in and a token to paste" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="rest">
    <div class="page">
      <p class="eyebrow">Beside the launching</p>
      <h2 class="rest__heading">The rest of what a library is for.</h2>

      <div class="tabs" data-tabs>
        <div class="tabs__bar" role="tablist" aria-label="What else Playfield does">
          {
            rest.map((pane, i) => (
              <button
                class="tabs__tab"
                role="tab"
                type="button"
                id={`tab-${pane.id}`}
                aria-controls={`pane-${pane.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                {pane.tab}
              </button>
            ))
          }
        </div>

        {
          rest.map((pane, i) => (
            <div
              class="tabs__pane"
              role="tabpanel"
              id={`pane-${pane.id}`}
              aria-labelledby={`tab-${pane.id}`}
              tabindex="0"
              data-first={i === 0 ? "true" : undefined}
            >
              <div class="tabs__text">
                <h3>{pane.heading}</h3>
                <p>{pane.body}</p>
              </div>
              <figure class="shot">
                <Image
                  src={pane.shot}
                  alt={pane.alt}
                  widths={[900, 1400, 1920]}
                  sizes="(max-width: 60rem) 100vw, 1100px"
                  loading="lazy"
                />
              </figure>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="page closing__inner">
      <h2 class="closing__heading">Your games, wherever you bought them.</h2>
      <Download meta={false}>
        <a class="btn btn-quiet" href={`${base}changelog/`}>Read the changelog</a>
      </Download>
      {
        latest && (
          <p class="closing__meta">
            {latest.version} · released {formatDate(latest.date)}
          </p>
        )
      }
    </div>
  </section>
</Base>

<script>
  // The panes are all in the document and all visible until this runs, so the
  // section reads as four stacked sections without JavaScript and collapses to
  // one at a time with it.
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panes = tabs.map((tab) =>
      document.getElementById(tab.getAttribute("aria-controls")!),
    );

    const show = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        panes[i]?.toggleAttribute("hidden", !on);
      });
      if (focus) tabs[index]!.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => show(i, false));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1, Home: -i, End: tabs.length - 1 - i }[
          event.key
        ];
        if (step === undefined) return;
        event.preventDefault();
        show((i + step + tabs.length) % tabs.length, true);
      });
    });

    root.dataset.live = "true";
    show(0, false);
  }
</script>

<style>
  /* Hero ---------------------------------------------------------------- */

  .hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
    /* A single brass wash behind the mark, low enough to read as light in the
       room rather than as a gradient. */
    background:
      radial-gradient(60rem 32rem at 12% -10%, rgb(224 164 88 / 0.09), transparent 70%),
      var(--ink);
  }

  .hero__lockup {
    max-width: 52rem;
  }

  .hero__mark {
    margin-bottom: var(--s-6);
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.94;
  }

  .hero__title-brass {
    color: var(--brass);
  }

  .hero__lede {
    margin-top: var(--s-6);
  }

  .chiprow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
    margin: var(--s-8) 0 0;
  }

  /* Screenshots ---------------------------------------------------------- */

  .shot {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--slate);
    /* The window is a contained object sitting in its own room — the one place
       this page uses a shadow. */
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.55);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .shot--hero {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    max-width: 72rem;
  }

  /* Bands and features --------------------------------------------------- */

  .band {
    padding-block: var(--s-24);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  /* A claim on the left, the working of it on the right — the shape the bands
     kept when the per-store table came out of them. */
  .statement {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .statement h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .statement__body .lede + .lede {
    margin-top: var(--s-6);
  }

  .feature {
    padding-block: var(--s-24) 0;
  }

  .feature__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .feature__text {
    max-width: 44rem;
  }

  /* Every other statement sits against the right edge instead of the left, so
     four sections of the same shape still read as a rhythm. */
  .feature--flip .feature__text {
    margin-left: auto;
  }

  .feature__text h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .feature__text .lede {
    margin-top: var(--s-6);
  }

  .feature__text code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--brass);
    background: var(--slate);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    padding: 0.1em 0.35em;
    /* A query broken across two lines reads as two queries. */
    white-space: nowrap;
  }

  /* The tabbed section --------------------------------------------------- */

  .rest {
    padding-block: var(--s-24);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  .rest__heading {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
    max-width: 30rem;
  }

  /* A segmented control rather than a row of underlined words — the shape the
     application itself uses wherever one of a few states is current. */
  .tabs__bar {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-12);
    padding: var(--s-1);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--slate);
  }

  .tabs__tab {
    appearance: none;
    background: none;
    border: 0;
    border-radius: var(--radius);
    padding: var(--s-3) var(--s-6);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.2;
    color: var(--faint);
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }

  .tabs__tab:hover {
    background: var(--slate-hi);
    color: var(--bone);
  }

  .tabs__tab:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .tabs__tab[aria-selected="true"],
  .tabs__tab[aria-selected="true"]:hover {
    background: var(--brass);
    color: var(--on-accent);
    font-weight: 600;
  }

  .tabs__pane {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: var(--s-12);
  }

  /* Without the script every pane stays in the flow, so each one needs the rule
     the tab bar would otherwise draw between them. */
  .tabs:not([data-live]) .tabs__pane + .tabs__pane {
    border-top: 1px solid var(--hairline);
  }

  .tabs__pane[hidden] {
    display: none;
  }

  .tabs__pane:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: var(--s-4);
  }

  .tabs__text {
    max-width: 44rem;
  }

  .tabs__text h3 {
    font-size: var(--text-xl);
  }

  .tabs__text p {
    margin-top: var(--s-4);
    color: var(--muted);
  }

  /* Closing -------------------------------------------------------------- */

  .closing {
    padding-block: var(--s-16) var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  .closing__heading {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .closing__meta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--faint);
    margin-top: var(--s-6);
  }

  /* Narrow --------------------------------------------------------------- */

  @media (max-width: 60rem) {
    .statement {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature--flip .feature__text {
      margin-left: 0;
    }
  }
</style>
