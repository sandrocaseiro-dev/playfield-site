---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import StoreChip from "../components/StoreChip.astro";
import Download from "../components/Download.astro";
import { getLatest, formatDate } from "../lib/releases";

import shotDetails from "../assets/shots/details.png";
import shotReconcile from "../assets/shots/reconcile.png";
import shotCollections from "../assets/shots/collections.png";
import shotCouch from "../assets/shots/couch-home.png";
import shotDeals from "../assets/shots/deals.png";
import shotBeat from "../assets/shots/beat.png";
import shotAchievements from "../assets/shots/achievements.png";
import shotCheats from "../assets/shots/cheats.png";
import shotStream from "../assets/shots/stream.png";
import shotPrefixes from "../assets/shots/prefixes.png";
import shotExternal from "../assets/shots/external.png";
import shotLaunch from "../assets/shots/launch-options.png";
import shotSaves from "../assets/shots/saves.png";
import shotDownloads from "../assets/shots/downloads.png";
import shotStats from "../assets/shots/stats.png";
import shotBackup from "../assets/shots/backup.png";
import shotMetadata from "../assets/shots/metadata.png";

const base = import.meta.env.BASE_URL;
const latest = await getLatest();

const stores = [
  { id: "steam", label: "Steam" },
  { id: "epic", label: "Epic Games" },
  { id: "gog", label: "GOG" },
  { id: "amazon", label: "Amazon Games" },
  { id: "ea", label: "EA" },
  { id: "bnet", label: "Battle.net" },
  { id: "ubi", label: "Ubisoft" },
  { id: "msft", label: "Microsoft Store" },
] as const;

// The panes of the tabbed section. Each one is a screen of the real
// application, so the tab it sits behind is named after what that screen shows
// rather than after the service it reads.
const rest = [
  {
    id: "beat",
    tab: "Playtime",
    heading: "Playtime and time to beat.",
    body: "HowLongToBeat times next to the hours you have played. Mark games as backlog, playing, completed or retired, and fix hours a store got wrong. Sign in to HowLongToBeat to sync your list with it.",
    shot: shotBeat,
    alt: "A game's page in Playfield, showing how long it takes to beat beside how long it has been played",
  },
  {
    id: "achievements",
    tab: "Achievements",
    heading: "Achievements from Steam, GOG, Epic and Microsoft.",
    body: "Achievements show on each game's page (Microsoft's on Windows only). If you own a game on two stores, you see both.",
    shot: shotAchievements,
    alt: "A game's achievements, with a tab each for Steam and GOG",
  },
  {
    id: "cheats",
    tab: "Cheats",
    heading: "Trainers and cheats.",
    body: "Playfield downloads trainers from FLiNG or GameCopyWorld and starts them with the game. With a Wand (WeMod) account, it can use Wand's cheats, and you turn them on from a window beside the game or from your phone.",
    shot: shotCheats,
    alt: "A game's cheats: Wand's cheats for the installed version and a FLiNG trainer",
  },
  {
    id: "launch",
    tab: "Launch options",
    heading: "Launch options, on Linux.",
    body: "Turn on HDR or the MangoHud overlay for each game, or add your own settings.",
    shot: shotLaunch,
    alt: "A game's launch options on Linux: HDR and the MangoHud overlay on, plus two custom settings",
  },
  {
    id: "external",
    tab: "Games you add",
    heading: "Add games from outside the stores.",
    body: "Choose the game's program file and Playfield finds its cover and description. It tracks playtime and shows in search like any other game.",
    shot: shotExternal,
    alt: "The Add a game dialog, where you choose the game's program",
  },
  {
    id: "tidy",
    tab: "Details and artwork",
    heading: "Fix missing details and artwork.",
    body: "See which games are missing a cover, description or other details, and link them to Steam or GOG to fill them in. With a free SteamGridDB key, choose any game's artwork. Hide games you don't want to see.",
    shot: shotMetadata,
    alt: "Settings, Metadata: five games missing details, each with what it lacks and a Link button",
  },
  {
    id: "disk",
    tab: "Disk space",
    heading: "See what takes up your disk.",
    body: "How much space your games use, by store, and on Windows by drive.",
    shot: shotStats,
    alt: "Stats: 879 GB on disk, broken down by drive and by store",
  },
  {
    id: "deals",
    tab: "Deals",
    heading: "Deals on your IsThereAnyDeal waitlist.",
    body: "Sign in to IsThereAnyDeal to see today's prices for your waitlist, in your currency and from the shops you choose. Deals ending soon, all-time lows and games you already own are marked.",
    shot: shotDeals,
    alt: "The deals pane, showing waitlisted games at their current prices across several shops",
  },
  {
    id: "backup",
    tab: "Backup",
    heading: "Back up your library.",
    body: "Save your corrections, statuses, playtimes, collections, hidden games, artwork choices and launch options to one file, and restore any of them on this computer or another. API keys and sign-ins are left out unless you include them.",
    shot: shotBackup,
    alt: "Settings, Backup: the parts of the library that go into the backup file, each with a checkbox",
  },
];
---

<Base
  title="Playfield — all your games, every store, one library"
  description="Playfield puts the games you own on Steam, Epic, GOG, Amazon, EA, Battle.net, Ubisoft and the Microsoft Store into one library. For Windows and Linux."
>
  <section class="hero">
    <div class="page hero__inner">
      <div class="hero__lockup">
        <Mark size={96} settle class="hero__mark" />
        <h1 class="hero__title">
          All your games.<br />
          <span class="hero__title-brass">Every store.<br />One place.</span>
        </h1>
        <p class="lede hero__lede">
          Playfield puts the games from all your stores in one library.
        </p>

        <Download />

        <ul class="chiprow" aria-label="Stores Playfield reads">
          {
            stores.map((store) => (
              <li>
                <StoreChip store={store.id} label={store.label} size={30} />
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="shot shot--hero">
        <Image src={shotDetails} alt="A game's page in Playfield, showing which stores it is owned on" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1100px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="band" id="no-sign-in">
    <div class="page statement">
      <div>
        <p class="eyebrow">Stores</p>
        <h2>Finds the games in your store apps.</h2>
      </div>
      <div class="statement__body">
        <p class="lede">
          Playfield reads your games from the store apps on your computer, so there are no
          accounts to connect. If a store's app is missing, Playfield installs it. You can
          install and uninstall games from Playfield.
        </p>
      </div>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Duplicates</p>
        <h2>One entry per game, whichever stores you bought it on.</h2>
        <p class="lede">
          The Play button starts whichever copy is installed. When Playfield isn't sure two games are the same, it asks you.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotReconcile} alt="Playfield asking whether BioShock on GOG and BioShock Remastered on Steam are the same game" widths={[900, 1280]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Saves</p>
        <h2>Cloud saves for every store.</h2>
        <p class="lede">
          Playfield syncs your saves between computers through Google Drive, OneDrive, Dropbox, MEGA, Proton Drive, Nextcloud and other services, or a folder you choose.
        </p>
        <p class="lede">
          If a save changed on two computers, you choose which one to keep. The other is kept too.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotSaves} alt="Settings, Saves: Google Drive as the default, MEGA as a second place, and a switch for each store" widths={[900, 1280]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Downloads · experimental</p>
        <h2>Download games without opening the store's app.</h2>
        <p class="lede">
          Works for Amazon and Steam games. Queue downloads, pause and resume them, and limit
          their speed.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotDownloads} alt="The library with games downloading, and the Downloads list open: one downloading, three waiting, one paused" widths={[900, 1280]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Collections</p>
        <h2>Collections that update themselves.</h2>
        <p class="lede">
          Make a collection from a search, like games you can finish in under 15 hours, or GOG games you have never started.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotCollections} alt="The Collections page: one per store, plus collections made from searches" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Linux</p>
        <h2>The Windows stores, on Linux.</h2>
        <p class="lede">
          Playfield installs GOG Galaxy, the Epic Games Launcher, Amazon Games, Ubisoft Connect, the EA app and Battle.net with a Proton version you already have, or uses the store apps you run in Lutris, Heroic or Bottles.
        </p>
        <p class="lede">
          Each game shows its ProtonDB rating, and games with a Linux version are marked.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotPrefixes} alt="Store settings on Linux, choosing which Proton version runs GOG Galaxy" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature feature--flip">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Console mode</p>
        <h2>A full-screen view for playing on a TV with a controller.</h2>
      </div>
      <figure class="shot">
        <Image src={shotCouch} alt="Console mode: a grid of game covers, with your collections as tabs across the top" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="page feature__inner">
      <div class="feature__text">
        <p class="eyebrow">Streaming · Windows</p>
        <h2>Stream your games with Moonlight.</h2>
        <p class="lede">
          Choose a collection and its installed games are added to Vibepollo, the streaming host on your computer, so you can play them with Moonlight on your TV, phone or laptop. You can open console mode from Moonlight too. You need Vibepollo installed.
        </p>
      </div>
      <figure class="shot">
        <Image src={shotStream} alt="Settings, Vibepollo: the address filled in and an empty token field" widths={[900, 1400, 1920]} sizes="(max-width: 60rem) 100vw, 1250px" />
      </figure>
    </div>
  </section>

  <section class="rest">
    <div class="page">
      <h2 class="rest__heading">What else Playfield does.</h2>

      <div class="tabs" data-tabs>
        <div class="tabs__bar" role="tablist" aria-label="What else Playfield does">
          {
            rest.map((pane, i) => (
              <button
                class="tabs__tab"
                role="tab"
                type="button"
                id={`tab-${pane.id}`}
                aria-controls={`pane-${pane.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                {pane.tab}
              </button>
            ))
          }
        </div>

        {
          rest.map((pane, i) => (
            <div
              class="tabs__pane"
              role="tabpanel"
              id={`pane-${pane.id}`}
              aria-labelledby={`tab-${pane.id}`}
              tabindex="0"
              data-first={i === 0 ? "true" : undefined}
            >
              <div class="tabs__text">
                <h3>{pane.heading}</h3>
                <p>{pane.body}</p>
              </div>
              <figure class="shot">
                <Image
                  src={pane.shot}
                  alt={pane.alt}
                  widths={[900, 1400, 1920]}
                  sizes="(max-width: 60rem) 100vw, 1100px"
                  loading="lazy"
                />
              </figure>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="page closing__inner">
      <h2 class="closing__heading">Download Playfield.</h2>
      <Download meta={false}>
        <a class="btn btn-quiet" href={`${base}changelog/`}>Read the changelog</a>
      </Download>
      {
        latest && (
          <p class="closing__meta">
            Version {latest.version} · released {formatDate(latest.date)}
          </p>
        )
      }
    </div>
  </section>
</Base>

<script>
  // The panes are all in the document and all visible until this runs, so the
  // section reads as four stacked sections without JavaScript and collapses to
  // one at a time with it.
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panes = tabs.map((tab) =>
      document.getElementById(tab.getAttribute("aria-controls")!),
    );

    const show = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        panes[i]?.toggleAttribute("hidden", !on);
      });
      if (focus) tabs[index]!.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => show(i, false));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1, Home: -i, End: tabs.length - 1 - i }[
          event.key
        ];
        if (step === undefined) return;
        event.preventDefault();
        show((i + step + tabs.length) % tabs.length, true);
      });
    });

    root.dataset.live = "true";
    show(0, false);
  }
</script>

<style>
  /* Hero ---------------------------------------------------------------- */

  .hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
    /* A single brass wash behind the mark, low enough to read as light in the
       room rather than as a gradient. */
    background:
      radial-gradient(60rem 32rem at 12% -10%, rgb(224 164 88 / 0.09), transparent 70%),
      var(--ink);
  }

  .hero__lockup {
    max-width: 52rem;
  }

  .hero__mark {
    margin-bottom: var(--s-6);
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 0.94;
  }

  .hero__title-brass {
    color: var(--brass);
  }

  .hero__lede {
    margin-top: var(--s-6);
  }

  .chiprow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
    margin: var(--s-8) 0 0;
  }

  /* Screenshots ---------------------------------------------------------- */

  .shot {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--slate);
    /* The window is a contained object sitting in its own room — the one place
       this page uses a shadow. */
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.55);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .shot--hero {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    max-width: 72rem;
  }

  /* Bands and features --------------------------------------------------- */

  .band {
    padding-block: var(--s-24);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  /* A claim on the left, the working of it on the right — the shape the bands
     kept when the per-store table came out of them. */
  .statement {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .statement h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .statement__body .lede + .lede {
    margin-top: var(--s-6);
  }

  .feature {
    padding-block: var(--s-24) 0;
  }

  .feature__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .feature__text {
    max-width: 44rem;
  }

  /* Every other statement sits against the right edge instead of the left, so
     four sections of the same shape still read as a rhythm. */
  .feature--flip .feature__text {
    margin-left: auto;
  }

  .feature__text h2 {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
  }

  .feature__text .lede {
    margin-top: var(--s-6);
  }

  .feature__text code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--brass);
    background: var(--slate);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    padding: 0.1em 0.35em;
    /* A query broken across two lines reads as two queries. */
    white-space: nowrap;
  }

  /* The tabbed section --------------------------------------------------- */

  .rest {
    padding-block: var(--s-24);
    border-top: 1px solid var(--hairline);
    margin-top: var(--s-24);
  }

  .rest__heading {
    font-size: var(--text-2xl);
    margin-top: var(--s-4);
    max-width: 30rem;
  }

  /* A segmented control rather than a row of underlined words — the shape the
     application itself uses wherever one of a few states is current. */
  .tabs__bar {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-12);
    padding: var(--s-1);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--slate);
  }

  .tabs__tab {
    appearance: none;
    background: none;
    border: 0;
    border-radius: var(--radius);
    padding: var(--s-3) var(--s-6);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.2;
    color: var(--faint);
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }

  .tabs__tab:hover {
    background: var(--slate-hi);
    color: var(--bone);
  }

  .tabs__tab:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .tabs__tab[aria-selected="true"],
  .tabs__tab[aria-selected="true"]:hover {
    background: var(--brass);
    color: var(--on-accent);
    font-weight: 600;
  }

  .tabs__pane {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: var(--s-12);
  }

  /* Without the script every pane stays in the flow, so each one needs the rule
     the tab bar would otherwise draw between them. */
  .tabs:not([data-live]) .tabs__pane + .tabs__pane {
    border-top: 1px solid var(--hairline);
  }

  .tabs__pane[hidden] {
    display: none;
  }

  .tabs__pane:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: var(--s-4);
  }

  .tabs__text {
    max-width: 44rem;
  }

  .tabs__text h3 {
    font-size: var(--text-xl);
  }

  .tabs__text p {
    margin-top: var(--s-4);
    color: var(--muted);
  }

  /* Closing -------------------------------------------------------------- */

  .closing {
    padding-block: var(--s-16) var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  .closing__heading {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .closing__meta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--faint);
    margin-top: var(--s-6);
  }

  /* Narrow --------------------------------------------------------------- */

  @media (max-width: 60rem) {
    .statement {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature--flip .feature__text {
      margin-left: 0;
    }
  }
</style>
